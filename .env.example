# =============================================================================
# Environment Variables Template
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=nepse_buy

# Full database URL (for backend)
DATABASE_URL=postgresql://postgres:your-secure-password-here@localhost:5432/nepse_buy?schema=public

# -----------------------------------------------------------------------------
# Redis (BullMQ + cache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
NODE_ENV=production
BACKEND_PORT=3001

# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=7d

# CORS — Flutter mobile uses native, so this matters only for any future web client / Swagger
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=signals@nepse-buy.local

# -----------------------------------------------------------------------------
# Market data scrapers
# -----------------------------------------------------------------------------
# User-Agent string sent to nepalstock.com.np / nepsealpha.com. Be polite.
SCRAPER_USER_AGENT=nepse-buy/0.1 (https://github.com/your-org/nepse-buy)
# How aggressively to retry on parser failure (jittered backoff).
SCRAPER_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Scheduler
# -----------------------------------------------------------------------------
# Cron expression for daily scrape + signal pipeline, in Asia/Kathmandu (NPT).
# Default: 16:00 NPT on Sun-Thu (NEPSE trading days).
SCHEDULE_CRON_DAILY=0 16 * * 0-4
SCHEDULE_TZ=Asia/Kathmandu
